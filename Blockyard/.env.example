# Local-only Prisma SQLite database. Do not put production user data here.
DATABASE_URL="file:../db/custom.db"

# Supabase project settings (the publishable key is browser-visible; never use a secret key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public WebSocket addresses. Use ws://localhost in local development or wss:// on Render.
NEXT_PUBLIC_GAME_SERVER_URL=
NEXT_PUBLIC_SYNC_SERVER_URL=

# Private server-side HMAC secret: same value in the website, game server and Studio sync service.
GAME_SERVER_TICKET_SECRET=

# Exact website origin(s), comma-separated, configured on both production WebSocket services.
GAME_ALLOWED_ORIGINS=
# One shared published-game session can hold up to 200 players.
GAME_SERVER_MAX_PLAYERS=200
# Multiplayer performance tuning (game-server only).
GAME_SERVER_SNAPSHOT_HZ=12
GAME_SERVER_VIEW_RADIUS=220
GAME_SERVER_MAX_VISIBLE_PLAYERS=64
